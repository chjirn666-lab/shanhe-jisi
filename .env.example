# Optional: all three are required to enable the server-side model.
# Copy to .env; never put API keys in dist/ or frontend JavaScript.
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=your-model-name
AI_API_KEY=
PORT=8790
HOST=127.0.0.1
# Public deployment: exact public origin, including https://; leave empty for localhost.
APP_ORIGIN=
# Trust only the reverse proxy IPs you control. Never trust arbitrary client headers.
TRUSTED_PROXY_IPS=
RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENCY=4
